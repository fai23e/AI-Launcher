{
  "manifest_version": 3,
  "name": "AI Customizer",
  "version": "0.3.0",
  "description": "AIサイトのカスタム指示を簡単に切り替え、管理します。",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.htm",
  "action": {
    "default_title": "AI Customizer",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://x.com/i/grok"
      ],
      "js": ["src/content-scripts/main.js"],
      "css": ["src/content-scripts/picker.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content-scripts/picker.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
