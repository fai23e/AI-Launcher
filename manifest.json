{
  "manifest_version": 3,
  "name": "AI Launcher",
  "version": "0.2.2",
  "description": "ショートカットキーで特定のサイトを専用ウィンドウで開く",
  "permissions": ["commands", "storage", "windows", "system.display", "activeTab"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.htm",
  "commands": {
    "open_launcher": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "ランチャーを開く"
    }
  },
  "action": {}
}
